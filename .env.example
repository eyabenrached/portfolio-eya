# ───────────── Copiez ce fichier en `.env` : cp .env.example .env ─────────────
# Docker Compose et le backend (en développement local) lisent ce fichier.

# Environnement : "development" (valeurs par défaut tolérées) ou "production" (le backend
# refuse de démarrer avec un SECRET_KEY / ADMIN_PASSWORD faibles ou par défaut)
ENVIRONMENT=development

# ── PostgreSQL ── (utilisez uniquement des caractères sûrs pour une URL : lettres, chiffres, - _ .)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
# Utilisée uniquement si vous lancez le backend SANS Docker (le compose la reconstruit lui-même)
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# ── Sécurité ──
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Mettre à true derrière HTTPS (cookie de session envoyé uniquement en HTTPS)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# ── Compte administrateur (créé au premier démarrage s'il n'existe pas) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Importe au premier démarrage le contenu actuel du portfolio (projets, compétences, etc.)
SEED_DEMO_DATA=true

# ── Coordonnées affichées sur le site (section Contact + footer) ──
SITE_EMAIL=votre.email@example.com
SITE_LOCATION=Tunisie
SITE_GITHUB_URL=
SITE_LINKEDIN_URL=
